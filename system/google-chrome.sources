# /etc/apt/sources.list.d/google-chrome.sources — Google Chrome. Deployed only
# when no Chrome repo exists yet; the package keeps managing the file afterwards.
Types: deb
URIs: https://dl.google.com/linux/chrome-stable/deb/
Suites: stable
Components: main
Architectures: amd64
Signed-By: /etc/apt/keyrings/google-chrome.asc
