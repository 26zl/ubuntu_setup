# ~/.ssh/config — client hardening. No key is generated by the setup: create one
# with `ssh-keygen -t ed25519 -a 100` (passphrase), then `gh ssh-key add ~/.ssh/id_ed25519.pub`.

# Per-machine host blocks (a homelab's, say) live in config.d; a glob that matches nothing is skipped.
# It comes before `Host *` because IdentityFile lines accumulate in reading order: their keys and
# certificates must be offered before the default below. Included files must be mode 600 or 644.
Include ~/.ssh/config.d/*.conf

Host *
    # gnome-keyring's agent caches the passphrase for the session
    AddKeysToAgent yes
    # only offer the key configured for a host, never every key in the agent
    IdentitiesOnly yes
    # hostnames in known_hosts are hashed so a stolen file lists no targets
    HashKnownHosts yes
    # host key changes are refused; brand-new hosts are still recorded on first use
    StrictHostKeyChecking accept-new
    ServerAliveInterval 30
    ServerAliveCountMax 3
    IdentityFile ~/.ssh/id_ed25519

Host github.com
    User git
